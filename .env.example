# --- Neon Postgres (Vercel Storage integration auto-injects these on Vercel) ---
# Pooled connection used at runtime by the Neon serverless driver
DATABASE_URL="postgres://user:password@ep-xxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"
# Direct (non-pooled) URL used only for `prisma migrate`
DATABASE_URL_UNPOOLED="postgres://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require"

# --- Auth.js ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-string"
# Local dev URL; on Vercel this is set automatically per environment.
AUTH_URL="http://localhost:3000"
